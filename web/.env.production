# The tile style behind the street-level map on the settlement pages.
#
# This key is public on purpose: it ships inside the page, as every browser
# map key does. What protects it is the origin restriction set in MapTiler —
# the key answers to https://oep-ellatas.vercel.app and returns 403 to any
# other site, so a copy of it is worth nothing. Revoking or rotating it is one
# click in cloud.maptiler.com/account/keys, and nothing else has to change.
#
# A value set in Vercel's own environment variables overrides this file, and
# a self-hosted Protomaps style would go here just as well — the code only
# ever sees a URL.
VITE_MAP_STYLE=https://api.maptiler.com/maps/streets-v2-dark/style.json?key=Tp4me5G8TSy8JetZeM6W
